# Hammasini o'zgartiring! Parollar kamida 16 belgi bo'lsin.
DB_OWNER_PASSWORD=change-me-db-owner-password
APP_DB_PASSWORD=change-me-app-password
# Kamida 32 belgi: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-Admin123
# Tizim ochiladigan manzil va port
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Tizim HTTPS orqali ochilsa true. Faqat HTTP bilan sinab ko'rish uchun false
COOKIE_SECURE=true

# ---------- Zaxira nusxa ----------
# Nusxalarni shifrlash kaliti (kamida 32 belgi: openssl rand -hex 32).
# MUHIM: bu kalitni server tashqarisida saqlang (parol menejeri). Kalitsiz nusxani ochib bo'lmaydi!
BACKUP_ENCRYPTION_KEY=change-me-backup-key-change-me-backup-key
# Jadval (Toshkent vaqti): har kuni 03:00; pilotdan keyin har soat: "0 * * * *"
BACKUP_CRON=0 3 * * *
RESTORE_TEST_CRON=0 5 1 * *
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=30
BACKUP_KEEP_MONTHLY=12
BACKUP_LABEL=ISTAM
# S3 (server tashqarisidagi saqlash joyi). Bo'sh qolsa nusxa faqat shu serverda bo'ladi — tavsiya etilmaydi.
# Boshqa provayder yoki boshqa data markazdagi S3 ni tanlang.
S3_BUCKET=
S3_PREFIX=istam
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Telegram ogohlantirishlar: @BotFather dan bot token, chat ID — guruh yoki shaxsiy chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ixtiyoriy: healthchecks.io kabi xizmat manzili — nusxa olinmasa ular ham xabar beradi
BACKUP_HEARTBEAT_URL=
# Har muvaffaqiyatli nusxadan keyin ham xabar yuborilsinmi
BACKUP_NOTIFY_SUCCESS=false
